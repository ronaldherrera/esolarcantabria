---
import Base from '../layouts/Base.astro';
import ParteSolar from '../components/ParteSolar.astro';
import GraficoMeses from '../components/GraficoMeses.astro';
import FormularioPresupuesto from '../components/FormularioPresupuesto.astro';
import { getCollection } from 'astro:content';
import municipios from '../data/municipios.json';
import { calculadoras } from '../data/calculadoras.js';
import { sitio } from '../data/sitio.js';
import { REFERENCIAS, numero } from '../lib/solar.js';
import Foto from '../components/Foto.astro';

const santander = municipios.find((m) => m.slug === 'santander')!;
const alfoz = municipios.find((m) => m.slug === 'alfoz-de-lloredo')!;
const porProduccion = [...municipios].sort((a, b) => b.anual - a.anual);
const mejor = porProduccion[0], peor = porProduccion.at(-1)!;
const masQueBerlin = municipios.filter((m) => m.anual > REFERENCIAS.berlin).length;
const difSantander = Math.round((santander.anual / REFERENCIAS.berlin - 1) * 100);
const eneroVeces = (santander.meses[0] / REFERENCIAS.berlinMeses[0]).toFixed(1).replace('.', ',');

const guias = (await getCollection('blog'))
  .sort((a, b) => Number(b.data.destacado) - Number(a.data.destacado) || b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 3);

const esquema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: sitio.nombre,
  url: sitio.url,
  logo: `${sitio.url}/marca/icono-512.png`,
  email: sitio.email,
  ...(sitio.telefono ? { telephone: sitio.telefono } : {}),
  areaServed: { '@type': 'AdministrativeArea', name: 'Cantabria' },
  description: 'Red de instaladores de placas solares en Cantabria: presupuestos de autoconsumo fotovoltaico con un instalador de la red cerca de tu casa.',
};
---
<Base
  titulo="Placas solares en Cantabria: presupuesto con instaladores cerca de ti | eSolar Cantabria"
  descripcion={`Placas solares en Cantabria con datos reales de tu municipio. Una placa en Santander produce un ${difSantander} % más que en Berlín. Calcula tu ahorro y pide presupuesto a un instalador de la red.`}
  esquema={esquema}
>
  <section class="hero">
    <div class="ancho hero-rejilla">
      <div>
        <h1>En Cantabria hay sol de sobra para tus placas</h1>
        <p class="entradilla">Una placa en Santander produce un {difSantander}&nbsp;% más que en Berlín, y Alemania está llena de placas. Te ponemos en contacto con un instalador de nuestra red que trabaja cerca de tu casa y te prepara el presupuesto sin compromiso.</p>
        <div class="acciones">
          <a class="boton" href="/presupuesto/">Pedir presupuesto</a>
          <a class="boton boton-sec" href="/calculadoras/ahorro-placas-solares/">Calcular mi ahorro</a>
        </div>
        <ul class="garantias">
          <li>{sitio.red.instalaciones} instalaciones hechas por la red</li>
          <li>Paneles Tier 1 con 25 años de garantía de producción</li>
          <li>Papeles y legalización incluidos</li>
        </ul>
      </div>
      <ParteSolar />
    </div>
  </section>

  <section class="ancho franja">
    <Foto clave="temas/costa-nubes" alt="Prados y acantilados de Toñanes, en la costa occidental de Cantabria, con el cielo cubierto" proporcion="21 / 8" prioridad
      pie={`Toñanes, en Alfoz de Lloredo, en un día cubierto. Aquí cada kWp de placas produce ${numero(alfoz.anual)} kWh al año.`} />
  </section>

  <section class="bloque bloque-bruma">
    <div class="ancho dos">
      <div>
        <h2>¿Y las nubes? Los datos dicen otra cosa</h2>
        <p class="entradilla">La duda de siempre en Cantabria es si las placas merecen la pena con tanto cielo cubierto. Las placas no necesitan sol directo: también producen con la luz difusa de un día nublado.</p>
        <p>Según PVGIS, la base de datos solar de la Comisión Europea, {masQueBerlin} de los 102 municipios de Cantabria producen más que Berlín. En enero, una placa en Santander produce {eneroVeces} veces lo que en Berlín.</p>
        <p>Dentro de Cantabria también hay diferencias: {mejor.nombre} produce {numero(mejor.anual)}&nbsp;kWh por kWp al año y {peor.nombre}, en un valle cerrado, {numero(peor.anual)}. Por eso cada presupuesto se calcula con el sol de tu municipio, no con una media.</p>
        <a class="mas" href="/placas-solares/">Ver la producción de los 102 municipios</a>
      </div>
      <div class="caja-grafico">
        <p class="cifra grande">{numero(santander.anual)} <small>kWh al año por kWp en Santander</small></p>
        <GraficoMeses meses={santander.meses} nombre="Santander" comparar={{ nombre: `Berlín (${numero(REFERENCIAS.berlin)} kWh)`, meses: REFERENCIAS.berlinMeses }} />
      </div>
    </div>
  </section>

  <section class="bloque">
    <div class="ancho">
      <h2>Cómo funciona</h2>
      <p class="entradilla">eSolar Cantabria es una red de instaladores. Tú pides el presupuesto aquí y lo prepara un instalador de la red que trabaja en tu zona.</p>
      <ol class="pasos">
        <li><h3>Nos cuentas tu caso</h3><p>Nombre, teléfono y municipio. Si has usado una calculadora, sus datos van con la solicitud.</p></li>
        <li><h3>Te llama un instalador cercano</h3><p>Uno de la red, de tu zona. Mira tu tejado y tus facturas y te da un presupuesto cerrado.</p></li>
        <li><h3>Instalación y papeles</h3><p>Montaje, certificado eléctrico, legalización, la declaración responsable en el ayuntamiento y los papeles para tu deducción.</p></li>
      </ol>
      <a class="mas" href="/como-funciona/#por-que-esolar">Por qué a través de eSolar y no directamente con un instalador</a>
    </div>
  </section>

  <section class="bloque bloque-bruma">
    <div class="ancho">
      <h2>Calculadoras con el sol de tu municipio</h2>
      <p class="entradilla">Cada cálculo usa la producción real de tu municipio mes a mes, y todos los supuestos están a la vista.</p>
      <ul class="tarjetas">
        {calculadoras.map((c) => (
          <li><a href={`/calculadoras/${c.slug}/`}><h3>{c.titulo}</h3><p>{c.descripcion}</p></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bloque">
    <div class="ancho dos">
      <div>
        <h2>Ayudas en 2026</h2>
        <p class="entradilla">Si terminas la instalación en 2026, puedes deducirte en el IRPF el 10 % de lo que pagues (el 20 % en edificios de viviendas), con una base máxima de 5.000 € al año.</p>
        <p>Las bonificaciones del IBI dependen de cada ayuntamiento y muchas solo valen para la solar térmica, la que calienta agua. Solo publicamos las que hemos comprobado en la ordenanza de cada municipio.</p>
        <div class="acciones">
          <a class="boton boton-sec" href="/ayudas/">Ver todas las ayudas</a>
          <a class="boton boton-sec" href="/calculadoras/deduccion-irpf/">Calcular mi deducción</a>
        </div>
      </div>
      <div class="caja caja-dato fuente">
        <p class="cifra">10 %</p>
        <p>de deducción en el IRPF por instalar autoconsumo en 2026 (20 % en edificios de viviendas).</p>
        <p class="nota">Real Decreto-ley 7/2026, de 20 de marzo. Disposición adicional 62.ª de la Ley del IRPF.</p>
      </div>
    </div>
  </section>

  {guias.length > 0 && (
    <section class="bloque bloque-bruma">
      <div class="ancho">
        <h2>Guías para decidir con calma</h2>
        <ul class="tarjetas">
          {guias.map((g) => (
            <li><a href={`/blog/${g.id}/`}><h3>{g.data.titulo}</h3><p>{g.data.descripcion}</p></a></li>
          ))}
        </ul>
        <a class="mas" href="/blog/">Todas las guías</a>
      </div>
    </section>
  )}

  <section class="bloque bloque-oscuro">
    <div class="ancho dos">
      <div>
        <h2>Pide tu presupuesto</h2>
        <p class="entradilla" style="color:#DCEAEE">Tres datos y listo. Te llama un instalador de la red de tu zona, mira tu caso y te da un presupuesto cerrado, sin compromiso.</p>
      </div>
      <FormularioPresupuesto id="presupuesto-portada" />
    </div>
  </section>
</Base>

<style>
  .franja { padding-bottom: clamp(2.5rem, 6vw, 4rem); }
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 5.5rem); }
  .hero-rejilla { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero h1 { font-size: clamp(2.3rem, 5.6vw, 4rem); }
  .garantias { list-style: none; padding: 0; margin-top: 2rem; display: grid; gap: .5rem; color: var(--cantabrico); font-weight: 600; }
  .garantias li { display: flex; gap: .6rem; align-items: baseline; }
  .garantias li::before { content: ''; width: .7rem; height: .7rem; border-radius: 50%; background: var(--sol); flex: none; transform: translateY(-1px); }
  @media (max-width: 900px) { .hero-rejilla { grid-template-columns: 1fr; } }

  .dos { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  @media (max-width: 900px) { .dos { grid-template-columns: 1fr; } }
  .dos p + p { margin-top: 1rem; }
  .caja-grafico { background: var(--blanco); border-radius: var(--radio-grande); padding: clamp(1.2rem, 3vw, 2rem); }
  .grande { font-size: clamp(2.4rem, 5vw, 3.4rem); margin-bottom: 1.4rem; }
  .grande small, .fuente .cifra small { display: block; font-size: 1rem; font-weight: 500; color: var(--ria); margin-top: .4rem; }
  .mas { display: inline-block; margin-top: 1.4rem; font-weight: 600; }

  .pasos { list-style: none; padding: 0; counter-reset: paso; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 2.2rem; }
  .pasos li { counter-increment: paso; border-top: 3px solid var(--cantabrico); padding-top: 1.1rem; }
  .pasos li::before { content: counter(paso); font-family: var(--titular); font-weight: 800; font-size: 2.2rem; color: var(--sol); line-height: 1; display: block; margin-bottom: .6rem; }
  .pasos p { margin-top: .5rem; }
  @media (max-width: 800px) { .pasos { grid-template-columns: 1fr; } }

  .tarjetas { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.2rem; margin-top: 2rem; }
  .tarjetas a { display: block; height: 100%; background: var(--blanco); border: 1px solid var(--linea); border-radius: var(--radio); padding: 1.4rem; text-decoration: none; color: var(--pizarra); transition: border-color .15s, transform .15s; }
  .tarjetas a:hover { border-color: var(--cantabrico); transform: translateY(-2px); }
  .tarjetas h3 { margin-bottom: .5rem; }
  .tarjetas p { font-size: .97rem; }
  .bloque-bruma .tarjetas a { border-color: transparent; }
  .bloque-bruma .tarjetas a:hover { border-color: var(--cantabrico); }

  .fuente { padding: 2rem; }
  .fuente .cifra { font-size: 4rem; color: var(--prado); }
  .fuente p + p { margin-top: .6rem; }
</style>
