---
import { sitio, enlaceWhatsapp } from '../data/sitio.js';
import { calculadoras } from '../data/calculadoras.js';
import municipios from '../data/municipios.json';

const principales = municipios.slice(0, 12);
const whatsapp = enlaceWhatsapp();
const anio = new Date().getFullYear();
---
<footer class="pie">
  <div class="ancho rejilla">
    <div class="presentacion">
      <img src="/marca/logotipo-negativo.svg" alt="eSolar Cantabria" width="490" height="196">
      <p>Red de instaladores de placas solares en Cantabria. Te ponemos en contacto con un instalador de la red que trabaja cerca de tu casa.</p>
      <ul class="contacto">
        <li><a href={`mailto:${sitio.email}`}>{sitio.email}</a></li>
        {sitio.telefono && <li><a href={`tel:${sitio.telefono.replace(/\s/g, '')}`}>{sitio.telefono}</a></li>}
        {whatsapp && <li><a href={whatsapp} rel="noopener">WhatsApp</a></li>}
      </ul>
    </div>
    <nav aria-label="Calculadoras">
      <h2>Calculadoras</h2>
      <ul>{calculadoras.map((c) => <li><a href={`/calculadoras/${c.slug}/`}>{c.corto}</a></li>)}</ul>
    </nav>
    <nav aria-label="Placas solares por municipio">
      <h2>Placas solares en</h2>
      <ul class="dos-columnas">
        {principales.map((m) => <li><a href={`/placas-solares/${m.slug}/`}>{m.nombre}</a></li>)}
      </ul>
      <a class="todos" href="/placas-solares/">Los 102 municipios</a>
    </nav>
    <nav aria-label="eSolar Cantabria">
      <h2>eSolar Cantabria</h2>
      <ul>
        <li><a href="/como-funciona/">Cómo funciona</a></li>
        <li><a href="/ayudas/">Ayudas y deducciones</a></li>
        <li><a href="/blog/">Guías</a></li>
        <li><a href="/preguntas-frecuentes/">Preguntas frecuentes</a></li>
        <li><a href="/instaladores/">Soy instalador</a></li>
        <li><a href="/presupuesto/">Pedir presupuesto</a></li>
      </ul>
    </nav>
  </div>
  <div class="ancho legal">
    <p>© {anio} {sitio.nombre}. Datos de producción solar: PVGIS, Comisión Europea.</p>
    <ul>
      <li><a href="/aviso-legal/">Aviso legal</a></li>
      <li><a href="/privacidad/">Privacidad</a></li>
      <li><a href="/cookies/">Cookies</a></li>
      <li><a href="/creditos/">Créditos de las fotos</a></li>
    </ul>
  </div>
</footer>

<style>
  .pie { background: var(--cantabrico-hondo); color: #C9DCE2; margin-top: 0; font-size: .97rem; }
  .rejilla { display: grid; gap: 2.5rem; padding-block: 3.5rem 2.5rem; grid-template-columns: 1.4fr 1fr 1.3fr 1fr; }
  @media (max-width: 960px) { .rejilla { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .rejilla { grid-template-columns: 1fr; } }
  .presentacion img { height: 52px; width: auto; margin-bottom: 1.1rem; }
  .pie h2 { font-size: 1rem; color: var(--blanco); margin-bottom: .8rem; letter-spacing: 0; }
  .pie ul { list-style: none; padding: 0; display: grid; gap: .45rem; }
  .pie a { color: #E3EEF1; text-decoration: none; }
  .pie a:hover { color: var(--sol); text-decoration: underline; }
  .contacto { margin-top: 1rem; }
  .dos-columnas { grid-template-columns: 1fr 1fr; column-gap: 1rem; }
  .todos { display: inline-block; margin-top: .8rem; color: var(--sol) !important; font-weight: 600; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .8rem; padding-block: 1.4rem; border-top: 1px solid rgba(255, 255, 255, .12); font-size: .88rem; }
  .legal ul { display: flex; gap: 1.2rem; }
</style>
