# eSolar Cantabria · Apache (Hostinger)
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Siempre https y sin www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://esolarcantabria.es%{REQUEST_URI} [L,R=301]

  # Direcciones de la web anterior
  RewriteRule ^index\.html$ / [L,R=301]
  RewriteRule ^servicios\.html$ /como-funciona/ [L,R=301]
  RewriteRule ^proceso\.html$ /como-funciona/ [L,R=301]
  RewriteRule ^nosotros\.html$ /como-funciona/ [L,R=301]
  RewriteRule ^subvenciones\.html$ /ayudas/ [L,R=301]
  RewriteRule ^faq\.html$ /preguntas-frecuentes/ [L,R=301]
  RewriteRule ^contacto\.html$ /presupuesto/ [L,R=301]
  RewriteRule ^aviso-legal\.html$ /aviso-legal/ [L,R=301]
  RewriteRule ^privacidad\.html$ /privacidad/ [L,R=301]
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L,R=301]

  # La carpeta interna y los datos de git no se sirven nunca
  RewriteRule ^_lib/ - [F,L]
  RewriteRule (^|/)\.git - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(css|js|woff2?|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
